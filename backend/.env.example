# LLM provider settings — copy to .env and fill values for local demo.
# 미설정 시 LLMClient는 claude CLI → template fallback 순으로 graceful degradation 합니다.

# Gemini API key. 미설정 시 Gemini 단계는 skip 됩니다. 시연 후 rotate 권장.
SMARTFACTORY_LLM_API_KEY=

# Gemini 모델명. 기본값: gemini-flash-latest (Google이 관리하는 최신 flash alias)
SMARTFACTORY_LLM_MODEL=gemini-flash-latest

# Gemini API 호출 timeout (초). 기본값: 10
SMARTFACTORY_LLM_TIMEOUT_SEC=10

# claude CLI subprocess timeout (초). 기본값: 15
SMARTFACTORY_LLM_CLI_TIMEOUT_SEC=15
